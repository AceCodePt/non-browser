#!/usr/bin/env bash
# session-idle - verification hook for this project.
#
# Contract: exit 0 passes AND commits the work; non-zero fails and everything
# written to stdout/stderr is fed back to the agent as its next instructions
# (the daemon retries up to verify.retryCap, then marks the task needs-review).
# Only the version committed on the base branch runs.
#
# Dispatch: run the feature-relevant verify subset by TASK_NAME instead of the
# full Playwright-heavy suite. Every subset rebuilds (tsc) before diffing its
# corpus; unknown/unmapped features fall back to the full `npm run verify`
# (build + charter check + four-layer spine diff). Pattern order matters - first
# match wins, so keep specific prefixes before looser ones.

set -euo pipefail
cd "${WORKTREE_PATH:-$(git rev-parse --show-toplevel)}" || exit 1

case "${TASK_NAME:-}" in
  *sweep*|*coverage-matrix*|*cross-family*) npm run verify:sweep && npm run verify:cross-family && node scripts/check-charter.mjs ;;
  *font-registration*) npm run build && node scripts/verify-font-registration.mjs && npm run verify:text-measure ;;
  *flexbox*)          npm run verify:layout-flexbox && npm run verify:sweep ;;
  *float*)            npm run verify:layout-floats ;;
  *grid*)             npm run verify:layout-grid ;;
  *position*)         npm run verify:layout-positioning ;;
  *media*|*container*) npm run verify:media-queries ;;
  *paint-text*)       npm run verify:paint-text ;;
  *paint-run-fallback*) npm run build && node scripts/verify-paint-fallback.mjs && npm run verify:paint-text ;;
  *border-radius*)    npm run verify:border-radius ;;
  *text-measure*|*measure-corpus*) npm run verify:text-measure ;;
  *text-align*)        npm run verify:text-align ;;
  *pseudo-elements*|*pseudo-element*) npm run verify:pseudo-elements ;;
  *firefox*|*font-fallback*) npm run verify:firefox ;;
  *pretext-breaker*)   npm run build && node scripts/verify-breaker.mjs && npm run verify:segmenter ;;
  *segmenter*|*text-breaker*) npm run verify:segmenter ;;
  *calc*)              npm run build && node scripts/verify-calc.mjs && npm run verify:sweep ;;
  *shadow*)            npm run build && node scripts/verify-shadow.mjs && npm run verify:paint-text ;;
  *opacity*)           npm run build && node scripts/verify-opacity.mjs && npm run verify:paint-text ;;
  *overflow*)          npm run build && node scripts/verify-overflow.mjs && npm run verify:paint-text ;;
  *rtl*)               npm run build && node scripts/verify-rtl.mjs && npm run verify:layout-positioning && npm run verify:layout-floats && npm run verify:layout-grid && npm run verify:layout-flexbox ;;
  *text-tier*)         npm run verify:paint-text && npm run verify:layout-floats && npm run verify:layout-grid && npm run verify:layout-flexbox && npm run verify:layout-positioning && npm run verify:firefox ;;
  *mean-gate*|*layer1*) npm run verify:four-layer && npm run verify:text-measure ;;
  *layers*|*output-selection*) npm run build && node scripts/verify-layers.mjs && npm run verify:four-layer ;;
  *spine*)            npm run verify:four-layer ;;
  *harness-tolerance*) npm run verify:report ;;
  *property-coverage*) npm run build && node scripts/verify-property-coverage.mjs && node scripts/check-charter.mjs ;;
  *stress*)            npm run build && node scripts/verify-stress.mjs ;;
  *)                  npm run verify:all ;;
esac

# The default `npm run verify` stays green on unchanged code, so a no-op agent
# could otherwise pass an empty session. Refuse to pass when the task branch
# carries no changes at all — neither committed beyond its base nor uncommitted
# in the worktree. (A doc-only task still produces a diff, so this only trips
# on genuinely empty work.)
if [ -z "$(git status --porcelain)" ]; then
  base="$(git merge-base HEAD main 2>/dev/null || true)"
  if [ -n "$base" ] && [ -z "$(git diff --name-only "$base" HEAD 2>/dev/null)" ]; then
    echo "session-idle: task produced no changes (branch == base, clean tree) — refusing to pass" >&2
    exit 1
  fi
fi

# Verification passed: commit the work (idempotent - an empty tree has nothing to
# commit, and it still passes so the daemon can re-run it safely).
if [ -n "$(git status --porcelain)" ]; then
  git add -A
  git -c user.name=orch -c user.email=orch@localhost \
      commit -q -m "orch: session-idle verification passed"
fi
exit 0
