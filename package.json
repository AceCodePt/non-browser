{
  "name": "cascade-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "non-browser server-side CSS cascade: selector matching, ordering, inheritance, UA stylesheet, computed values",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "npm run build && node scripts/check-charter.mjs && node scripts/verify-four-layer.mjs",
    "verify:four-layer": "npm run build && node scripts/verify-four-layer.mjs",
    "verify:cascade-core": "node scripts/verify-cascade-core.mjs",
    "harvest:cascade-core": "node scripts/harvest-computed.mjs",
    "harvest:oracle": "node scripts/harvest-oracle.mjs",
    "verify:report": "npm run build && node scripts/verify-report.mjs",
    "verify:layout-floats": "npm run build && node scripts/verify-layout-floats.mjs",
    "verify:layout-grid": "npm run build && node scripts/verify-layout-grid.mjs",
    "verify:layout-flexbox": "npm run build && node scripts/verify-layout-flexbox.mjs",
    "verify:layout-positioning": "npm run build && node scripts/verify-layout-positioning.mjs",
    "verify:media-queries": "npm run build && node scripts/verify-media-queries.mjs",
    "verify:paint-text": "npm run build && node scripts/verify-paint-text.mjs",
    "verify:text-measure": "npm run build && node scripts/verify-text-measure.mjs",
    "verify:firefox": "npm run build && node scripts/verify-firefox.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@napi-rs/canvas": "^1.0.5",
    "css-tree": "^3.2.1",
    "parse5": "^7.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "playwright": "^1.45.0",
    "typescript": "^5.5.3"
  }
}
