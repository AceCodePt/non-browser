    "measureText": [
      { "text": "Item: Total", "font": "14px 'Noto Sans'" }
    ],
    "rects": ["box", "t1"],
    "textElements": ["t1"],
    "computedStyle": [
      { "id": "box", "pseudo": "before", "props": ["content", "color", "font-size", "font-family", "display"] },
      { "id": "t1", "props": ["font-size", "color"] }
    ]
  },
