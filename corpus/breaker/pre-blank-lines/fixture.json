{
  "name": "pre-blank-lines",
  "category": "forced-breaks",
  "note": "white-space:pre with interior blank lines: empty interior segments occupy full line-height boxes, matching Chrome.",
  "fonts": [{ "family": "Noto Sans", "file": "/usr/share/fonts/google-noto/NotoSans-Regular.ttf" }],
  "harvest": {
    "viewport": { "width": 460, "height": 220 },
    "html": "<html><head><style>html,body{margin:0;padding:0}</style></head><body><div id=\"p\" style=\"font-family:'Noto Sans';font-size:16px;line-height:24px;width:300px;white-space:pre\">line one\n\nline three\n\n\nline six</div></body></html>",
    "textElements": ["p"]
  }
}
