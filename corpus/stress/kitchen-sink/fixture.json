    "html": "<html><head><style>html,body{margin:0;padding:0}body{font-family:'Noto Sans';font-size:15px;line-height:23px;color:#1a2233;background:#eef1f6}#topbar{position:fixed;top:0;left:0;right:0;z-index:10;height:48px;background-color:#0f2a5e;box-shadow:0 2px 6px rgba(20,30,60,0.3)}.brand{position:absolute;left:16px;top:13px;color:#ffffff;font-size:16px;font-weight:700}.nav{position:absolute;right:16px;top:0;height:48px;display:flex;flex-direction:row;align-items:center;gap:16px;margin:0;padding:0;list-style:none}.nav-item{position:relative;display:block;height:20px}.nav-link{display:block;color:#cfe0ff;height:20px;line-height:20px}.dropdown{position:absolute;top:34px;left:0;z-index:12;margin:0;padding:6px 0;width:130px;list-style:none;background-color:#ffffff;border:1px solid #cdd4e2;box-shadow:0 2px 8px rgba(20,30,60,0.18)}.dropdown li{padding:4px 12px;color:#1a2233}main{padding-top:64px;margin:16px}.hero{position:relative;padding:24px 18px;background-color:#ffffff;border:1px solid #d5dbe7;border-radius:10px;margin-bottom:16px}.hero h1{margin:0 0 8px;font-size:24px;line-height:30px;color:#0f2a5e}.hero p{margin:0;color:#3a4556}.badge{position:absolute;top:14px;right:14px;z-index:5;padding:6px 12px;background-color:#e8f0ff;border:1px solid #0f2a5e;border-radius:12px;color:#0f2a5e;font-size:12px;line-height:16px;font-weight:600}.cards{display:grid;grid-template-columns:repeat(1,minmax(0,1fr));gap:14px;margin-bottom:16px}.card{display:flex;flex-direction:column;gap:6px;padding:14px;border:1px solid #cfd6e4;border-radius:10px;background-color:#ffffff;box-shadow:0 2px 6px rgba(20,30,60,0.12)}.card h3{margin:0;font-size:16px;line-height:22px;color:#0f2a5e}.card p{margin:0;font-size:13px;line-height:19px;color:#3a4556}.wrap{margin:0 0 16px}.rtl{display:block;direction:rtl;padding:14px 16px;margin:0 0 16px;background-color:#ffffff;border:1px solid #d5dbe7;border-radius:8px}.rtl h2{direction:rtl;font-size:18px;line-height:24px;color:#0f2a5e;text-align:right;margin:0 0 6px}.rtl p{text-align:right;margin:0;color:#3a4556}.article{padding:16px;background-color:#ffffff;border:1px solid #d5dbe7;border-radius:8px}.article h2{font-size:20px;line-height:26px;color:#0f2a5e;margin:0 0 10px}.article p{margin:0 0 12px}.tracked{letter-spacing:1.5px;color:#0f2a5e;margin:0 0 12px}.article blockquote{margin:0 0 12px;padding:8px 12px;border-left:3px solid #c7d0e2;background-color:#f0f3f9;font-style:italic}.article blockquote::before{content:\"\\201C\";color:#0f2a5e;font-size:22px}.article ul{margin:0 0 12px;list-style-type:disc;list-style-position:outside}.article li{margin:0}.article pre{margin:0;padding:10px;background-color:#eef1f6;border:1px solid #d8deea;white-space:pre;font-size:13px;line-height:19px}.formwrap{padding:16px;background-color:#ffffff;border:1px solid #d5dbe7;border-radius:8px;margin-bottom:16px}.formwrap h2{font-size:20px;line-height:26px;color:#0f2a5e;margin:0 0 12px}.field{margin-bottom:12px}label{display:inline-block;margin-bottom:4px;font-size:13px;color:#22304a}.inp{display:block;box-sizing:border-box;width:100%;height:32px;border:1px solid #99a1b3;padding:6px;background-color:#ffffff;font-size:13px}.submit{display:block;box-sizing:border-box;width:100%;height:36px;border:1px solid #0f2a5e;background-color:#0f2a5e;color:#ffffff;font-size:13px;font-weight:600;line-height:34px;text-align:center}.foot{padding:14px 16px;background-color:#0f2a5e;color:#cfe0ff;border-radius:8px;text-align:center;font-size:13px}.dim{opacity:0.85}@media (min-width:900px){.cards{grid-template-columns:repeat(3,minmax(0,1fr))}}</style></head><body><header id=\"topbar\"><span class=\"brand\" id=\"brand\">Acme Corp</span><ul class=\"nav\" id=\"nav\"><li class=\"nav-item\" id=\"navi1\"><a class=\"nav-link\" id=\"navlink1\" href=\"#\">Products</a><ul class=\"dropdown\" id=\"dd\"><li id=\"dd1\">Sub Alpha</li><li id=\"dd2\">Sub Beta</li></ul></li><li class=\"nav-item\" id=\"navi2\"><a class=\"nav-link\" id=\"navlink2\" href=\"#\">About</a></li><li class=\"nav-item\" id=\"navi3\"><a class=\"nav-link\" id=\"navlink3\" href=\"#\">Contact</a></li></ul></header><main><section class=\"hero\" id=\"hero\"><h1 id=\"heroh\">Welcome to the kitchen sink</h1><p id=\"herop\">Every CSS family the engine verifies, combined on one page at three viewports.</p><span class=\"badge\" id=\"badge\">New</span></section><section class=\"cards\" id=\"cards\"><article class=\"card\" id=\"card1\"><h3 id=\"ct1\">Alpha card</h3><p id=\"cb1\">A compact summary of the first metric with a headline figure and a supporting sentence.</p></article><article class=\"card\" id=\"card2\"><h3 id=\"ct2\">Beta card</h3><p id=\"cb2\">The second panel shows progress across a longer window using flex column alignment.</p></article><article class=\"card\" id=\"card3\"><h3 id=\"ct3\">Gamma card</h3><p id=\"cb3\">Third panel: tighter text that wraps to several lines in a narrow column.</p></article><article class=\"card\" id=\"card4\"><h3 id=\"ct4\">Delta card</h3><p id=\"cb4\">A wider block of body copy that exercises interword wrapping and measurement.</p></article><article class=\"card\" id=\"card5\"><h3 id=\"ct5\">Epsilon card</h3><p id=\"cb5\">A fifth panel added so the grid wraps across multiple rows at small sizes.</p></article><article class=\"card\" id=\"card6\"><h3 id=\"ct6\">Zeta card</h3><p id=\"cb6\">Sixth card keeps the auto-placement busy and proves the track math.</p></article></section><section class=\"wrap\" id=\"wrap\"><div class=\"rtl\" id=\"rtl\"><h2 id=\"rth\">RTL section</h2><p id=\"rtp\">This block flows right-to-left, mirroring its box and alignment while the rest of the page stays left-to-right.</p></div><div class=\"article\" id=\"article\"><h2 id=\"arth\">Reading</h2><p id=\"arp\">Ordinary body text that wraps at the container edge and continues over several lines of prose.</p><p class=\"tracked\" id=\"artrack\">A letter-spaced line that tracks its glyphs across the column.</p><blockquote id=\"arq\">A short quote pulls out a key line for emphasis.</blockquote><ul id=\"arl\"><li id=\"arli1\">First point</li><li id=\"arli2\">Second point</li><li id=\"arli3\">Third point</li></ul><pre id=\"arpre\">one line\\n  two line\\n  three line</pre></div></section><section class=\"formwrap\" id=\"formwrap\"><h2 id=\"fh\">Contact us</h2><div class=\"field\" id=\"fld1\"><label id=\"f1l\" for=\"f1\">Name</label><input class=\"inp\" id=\"f1\" type=\"text\"></div><div class=\"field\" id=\"fld2\"><label id=\"f2l\" for=\"f2\">Email</label><input class=\"inp\" id=\"f2\" type=\"text\"></div><div class=\"submit\" id=\"go\">Send message</div></section><footer class=\"foot\" id=\"foot\">End of the kitchen sink page</footer></main></body></html>",
